# Copy to .env and fill in. Never commit .env.

# Anthropic API key for Module 4 (AI commentary). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# SEC EDGAR requires a descriptive User-Agent with a contact email (SEC fair-access policy).
SEC_USER_AGENT=CompsAI brett@example.com

# Optional: override the Claude model used for commentary (default claude-sonnet-4-6).
# COMPSAI_MODEL=claude-sonnet-4-6

# Optional: where cached EDGAR/market responses live (default: data/cache under the project root).
# COMPSAI_CACHE_DIR=data/cache
